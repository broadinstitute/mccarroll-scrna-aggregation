nextflow_process {

    name "Test Process BUILD_LIBRARY_CELL_METADATA"
    script "modules/local/build_library_cell_metadata/main.nf"
    process "BUILD_LIBRARY_CELL_METADATA"
    config "./nextflow.config"
    tag "modules"
    tag "modules_local"
    tag "build_library_cell_metadata"

    // Contract: record(id: String, cell_metadata: Path, mmc_tsv: Path? (null for none), args: List<String> ([] for none), extra_files: List<Path> ([] for none))
    //           -> cell_metadata: record(id: String, cell_metadata: Path '<ext.prefix ?: id>.joined_filtered_cell_metadata.txt').
    // args are the manifest's donor, joins and filters; the task writes them one per line to <id>.join_and_filter_args.txt (a zero-byte
    // file for none) for join_and_filter_tsv --args-file; there is no ext.args. The tests read the arguments from the args_*.txt fixtures.
    // Fixtures: tests/fixtures/README.md. No live test: merged outputs are checked by the final integration test.

    def tsvLines = { f -> file(f).readLines().collect { it.split('\t', -1) as List } }

    test("Should add PREFIX as the first column and keep the rows unchanged") {

        when {
            process {
                """
                input[0] = record(id: 'LIB_A', cell_metadata: file("${moduleDir}/tests/fixtures/cmd.tsv"), mmc_tsv: null, args: file("${moduleDir}/tests/fixtures/args_empty.txt").readLines(), extra_files: [])
                """
            }
        }

        then {
            def lines = tsvLines(process.out.cell_metadata[0].cell_metadata)
            assertAll(
                { assert process.success },
                { assert process.out.cell_metadata.size() == 1 },
                // id propagated; name from id
                { assert process.out.cell_metadata[0].id == 'LIB_A' },
                { assert file(process.out.cell_metadata[0].cell_metadata).name == 'LIB_A.joined_filtered_cell_metadata.txt' },
                // PREFIX = id first, then the original columns and rows in order
                { assert lines[0] == ['PREFIX', 'cell_barcode', 'num_transcripts', 'pct_mt', 'donor'] },
                { assert lines.drop(1) == [
                    ['LIB_A', 'AAAA', '100', '0.05', 'd1'],
                    ['LIB_A', 'CCCC', '200', '0.25', 'd2'],
                    ['LIB_A', 'GGGG', '300', '0.01', 'd3'] ] }
            )
        }
    }

    test("Should left-join MapMyCells on cell_barcode and keep a cell without an annotation") {

        when {
            process {
                """
                input[0] = record(id: 'LIB_A', cell_metadata: file("${moduleDir}/tests/fixtures/cmd.tsv"), mmc_tsv: file("${moduleDir}/tests/fixtures/mmc.tsv"), args: file("${moduleDir}/tests/fixtures/args_empty.txt").readLines(), extra_files: [])
                """
            }
        }

        then {
            def lines = tsvLines(process.out.cell_metadata[0].cell_metadata)
            assertAll(
                { assert process.success },
                // MapMyCells columns are added after the input columns; the join key cell_id is not added
                { assert lines[0] == ['PREFIX', 'cell_barcode', 'num_transcripts', 'pct_mt', 'donor', 'M_class_name'] },
                // all 3 cells kept; CCCC has no annotation, so an empty value
                { assert lines.drop(1) == [
                    ['LIB_A', 'AAAA', '100', '0.05', 'd1', 'Glut'],
                    ['LIB_A', 'CCCC', '200', '0.25', 'd2', ''],
                    ['LIB_A', 'GGGG', '300', '0.01', 'd3', 'GABA'] ] }
            )
        }
    }

    test("Should add the donor and apply the filters of the arguments file, including a filter on a MapMyCells column") {

        when {
            process {
                """
                input[0] = record(id: 'LIB_A', cell_metadata: file("${moduleDir}/tests/fixtures/cmd_no_donor.tsv"), mmc_tsv: file("${moduleDir}/tests/fixtures/mmc.tsv"), args: file("${moduleDir}/tests/fixtures/args_donor_filters.txt").readLines(), extra_files: [])
                """
            }
        }

        then {
            def lines = tsvLines(process.out.cell_metadata[0].cell_metadata)
            def header = lines[0]
            assertAll(
                { assert process.success },
                // CCCC removed by --max pct_mt 0.1 (0.25); GGGG removed by --exclude M_class_name GABA (a column of the MapMyCells join, which comes first)
                { assert lines.size() == 2 },
                { assert lines[1][header.indexOf('cell_barcode')] == 'AAAA' },
                // donor added by --set (the input has no donor column: --set never replaces data); PREFIX stays the library id
                { assert lines[1][header.indexOf('donor')] == 'N1' },
                { assert lines[1][header.indexOf('PREFIX')] == 'LIB_A' },
                { assert lines[1][header.indexOf('M_class_name')] == 'Glut' }
            )
        }
    }

    test("Should join a staged extra file named in the arguments file") {

        when {
            process {
                """
                input[0] = record(id: 'LIB_A', cell_metadata: file("${moduleDir}/tests/fixtures/cmd.tsv"), mmc_tsv: null, args: file("${moduleDir}/tests/fixtures/args_join_extra.txt").readLines(), extra_files: [ file("${moduleDir}/tests/fixtures/extra.tsv") ])
                """
            }
        }

        then {
            def lines = tsvLines(process.out.cell_metadata[0].cell_metadata)
            assertAll(
                { assert process.success },
                // extra.tsv's columns are added (its join column cell is not); GGGG, absent from extra.tsv, is kept with an empty value
                { assert lines[0] == ['PREFIX', 'cell_barcode', 'num_transcripts', 'pct_mt', 'donor', 'extra_flag'] },
                { assert lines.drop(1).collect { it[[1, 5]] } == [ ['AAAA', 'yes'], ['CCCC', 'no'], ['GGGG', ''] ] }
            )
        }
    }

    test("Should apply an argument with spaces, a dollar sign and a quote exactly as written in the arguments file") {

        when {
            process {
                """
                input[0] = record(id: 'LIB_A', cell_metadata: file("${moduleDir}/tests/fixtures/cmd_no_donor.tsv"), mmc_tsv: null, args: file("${moduleDir}/tests/fixtures/args_special_value.txt").readLines(), extra_files: [])
                """
            }
        }

        then {
            def lines = tsvLines(process.out.cell_metadata[0].cell_metadata)
            def donors = lines.drop(1).collect { it[lines[0].indexOf('donor')] }
            def argsFile = new File(new File(process.out.cell_metadata[0].cell_metadata.toString()).parentFile, 'LIB_A.join_and_filter_args.txt')
            assertAll(
                { assert process.success },
                // the value is one argument, not expanded by the shell, and not split at the spaces
                { assert donors == ["N 1 \$HOME 'r'"] * 3 },
                { assert lines.size() == 4 },
                // the arguments file the task wrote has the arguments exactly, one per line
                { assert argsFile.text == "--set\ndonor\nN 1 \$HOME 'r'\n" }
            )
        }
    }

    test("Should write a zero-byte arguments file when there are no arguments") {

        when {
            process {
                """
                input[0] = record(id: 'LIB_A', cell_metadata: file("${moduleDir}/tests/fixtures/cmd.tsv"), mmc_tsv: null, args: [], extra_files: [])
                """
            }
        }

        then {
            def argsFile = new File(new File(process.out.cell_metadata[0].cell_metadata.toString()).parentFile, 'LIB_A.join_and_filter_args.txt')
            assertAll(
                { assert process.success },
                // empty, not one empty line (which printf with no arguments would write)
                { assert argsFile.exists() },
                { assert argsFile.length() == 0 },
                { assert tsvLines(process.out.cell_metadata[0].cell_metadata).size() == 4 }
            )
        }
    }

    test("Should add no MapMyCells columns when the library has no MapMyCells TSV") {

        when {
            process {
                """
                input[0] = record(id: 'LIB_NA', cell_metadata: file("${moduleDir}/tests/fixtures/cmd.tsv"), mmc_tsv: null, args: file("${moduleDir}/tests/fixtures/args_empty.txt").readLines(), extra_files: [])
                """
            }
        }

        then {
            def lines = tsvLines(process.out.cell_metadata[0].cell_metadata)
            assertAll(
                { assert process.success },
                { assert lines[0] == ['PREFIX', 'cell_barcode', 'num_transcripts', 'pct_mt', 'donor'] },
                { assert lines.size() == 4 },
                { assert lines.drop(1).every { it[0] == 'LIB_NA' } }
            )
        }
    }
}
