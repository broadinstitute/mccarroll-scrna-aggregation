// Config for the live gs:// test of SUMMARIZE_SCRNA_EXPERIMENTS (tag 'gcs').
// Mirrors the docker profile: the host's gcloud Application Default Credentials are mounted into the container.
// params.gcp_credentials_file is not visible here (this file is loaded before the pipeline params), so the default path is
// built directly; if it were null, Docker would silently create a named volume called 'null' at the mount point.
env.GOOGLE_APPLICATION_CREDENTIALS = '/opt/gcp/adc.json'
process.containerOptions = "-v ${System.getProperty('user.home')}/.config/gcloud/application_default_credentials.json:/opt/gcp/adc.json:ro"
// The Google storage client also needs a project ID, taken from GOOGLE_PROJECT_ID as in the docker profile.
env.GOOGLE_CLOUD_PROJECT = System.getenv('GOOGLE_PROJECT_ID') ?: ''
