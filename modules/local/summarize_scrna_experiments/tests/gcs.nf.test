nextflow_process {

    name "Test Process SUMMARIZE_SCRNA_EXPERIMENTS against gs://"
    script "modules/local/summarize_scrna_experiments/main.nf"
    process "SUMMARIZE_SCRNA_EXPERIMENTS"
    config "./gcs.config"
    tag "modules"
    tag "modules_local"
    tag "summarize_scrna_experiments"
    tag "gcs"

    // Live test: needs network, a GCP credentials JSON, GOOGLE_PROJECT_ID and the docker profile (see docs/testing.md,
    // "Live tests"; tests/run_all_tests.sh sets the variables for the live tests).
    // SCRNA_LIVE_BASELINE_ROOT is the output directory of a validated prototype run. It holds
    //   artifacts/<library>.yaml                                (the input of this test, real gs:// URLs)
    //   artifacts/<library>.library_metrics.txt                 (expected metrics)
    //   tearsheets/<library>.standard_analysis_tearsheet.txt    (expected tearsheet)
    // SCRNA_LIVE_LIBRARY names the library; it may be omitted when artifacts/ holds exactly one <library>.yaml.
    // The generated metrics are compared column by column and the tearsheet row by row; all differences are printed.
    // Note run_date and run_status come from the newest Nextflow trace in the bucket, so a new run there
    // makes those two columns differ from an older baseline.

    test("Should reproduce the validated library metrics and tearsheet of a real gs:// library") {

        when {
            // resolved here (not inside the process string) so a missing variable gives a clear message
            assert System.getenv('SCRNA_LIVE_BASELINE_ROOT') : 'SCRNA_LIVE_BASELINE_ROOT is not set (see docs/testing.md, Live tests)'
            def root = new File(System.getenv('SCRNA_LIVE_BASELINE_ROOT'))
            def lib = System.getenv('SCRNA_LIVE_LIBRARY')
            if (!lib) {
                def yamls = new File(root, 'artifacts').listFiles().findAll { it.name.endsWith('.yaml') }
                assert yamls.size() == 1 : "set SCRNA_LIVE_LIBRARY: ${yamls*.name} found in ${root}/artifacts"
                lib = yamls[0].name - '.yaml'
            }
            process {
                """
                input[0] = [ [ id:'${lib}', analysis_id:'live_analysis' ], file('${root}/artifacts/${lib}.yaml') ]
                """
            }
        }

        then {
            def root = new File(System.getenv('SCRNA_LIVE_BASELINE_ROOT'))
            def lib = process.out.metrics[0][0].id
            def parse = { File f ->
                def lines = f.readLines()
                def header = lines[0].split('\t', -1) as List
                [header, lines.drop(1).collect { l -> l.split('\t', -1) as List }]
            }
            def generatedMetrics = file(process.out.metrics[0][1])
            def baselineMetrics = new File(root, "artifacts/${lib}.library_metrics.txt")
            def generatedTearsheet = file(process.out.tearsheet[0][1])
            def baselineTearsheet = new File(root, "tearsheets/${lib}.standard_analysis_tearsheet.txt")

            println ""
            println "Generated metrics:   ${generatedMetrics}"
            println "Baseline metrics:    ${baselineMetrics}"
            println "Generated tearsheet: ${generatedTearsheet}"
            println "Baseline tearsheet:  ${baselineTearsheet}"

            def (gHeader, gRows) = parse(generatedMetrics)
            def (bHeader, bRows) = parse(baselineMetrics)
            def metricDiffs = []
            if (gHeader != bHeader) {
                metricDiffs << "columns differ: generated=${gHeader} baseline=${bHeader}".toString()
            } else if (gRows.size() != bRows.size()) {
                metricDiffs << "row count: generated=${gRows.size()} baseline=${bRows.size()}".toString()
            } else {
                gHeader.eachWithIndex { col, i ->
                    if (gRows[0][i] != bRows[0][i]) {
                        metricDiffs << "${col}: generated=${gRows[0][i]} baseline=${bRows[0][i]}".toString()
                    }
                }
            }
            def tearsheetDiffs = []
            def gLines = generatedTearsheet.readLines()
            def bLines = baselineTearsheet.readLines()
            if (gLines != bLines) {
                (0..<Math.max(gLines.size(), bLines.size())).each { i ->
                    def g = i < gLines.size() ? gLines[i] : '(missing)'
                    def b = i < bLines.size() ? bLines[i] : '(missing)'
                    if (g != b) tearsheetDiffs << "line ${i + 1}: generated=${g} baseline=${b}".toString()
                }
            }
            println(metricDiffs ? "Metrics: ${metricDiffs.size()} difference(s):" : "Metrics: matches baseline (${bHeader.size()} columns)")
            metricDiffs.each { println "    ${it}" }
            println(tearsheetDiffs ? "Tearsheet: ${tearsheetDiffs.size()} difference(s):" : "Tearsheet: matches baseline (${bLines.size()} lines)")
            tearsheetDiffs.each { println "    ${it}" }

            assertAll(
                { assert process.success },
                { assert gRows.size() == 1 },
                { assert gRows[0][0] == lib },
                { assert metricDiffs.isEmpty() },
                { assert tearsheetDiffs.isEmpty() }
            )
        }
    }
}
