nextflow_process {

    name "Test Process SUMMARIZE_SCRNA_EXPERIMENTS"
    script "modules/local/summarize_scrna_experiments/main.nf"
    process "SUMMARIZE_SCRNA_EXPERIMENTS"
    config "./nextflow.config"
    tag "modules"
    tag "modules_local"
    tag "summarize_scrna_experiments"

    // Contract: record(meta: Map, artifacts_yaml: Path) -> summary: record(meta: Map, metrics: Path '<id>.library_metrics.txt',
    //   tearsheet: Path 'tearsheets/<id>.standard_analysis_tearsheet.txt').
    // meta.id is the library id (uei); meta.analysis_id is the analysis id. The real-data check is in gcs.nf.test.
    // Fixtures (tests/fixtures; the tool reads the files the YAML points at, mounted at /fixtures):
    //   LIB_FULL: small real files: properties (experimentDate 2024-01-02), execution trace dated 2026-03-04 (TASK_B failed
    //             once, then completed), read quality (2,000,000 / 1,900,000 / 1,800,000 reads), chimeric UMIs (5 of 1000),
    //             cell metadata (1 doublet in 4 cells), selected cells (AAAA CCCC GGGG with 100/200/300 UMIs),
    //             cell selection report (reads/UMI 1.54, ambient 40).
    //   LIB_NA:   every artifact NA.

    def parseTsv = { text ->
        def lines = text.readLines()
        def header = lines[0].split('\t', -1) as List
        lines.drop(1).collect { l -> [header, l.split('\t', -1) as List].transpose().collectEntries { k, v -> [(k): v] } }
    }

    test("Should emit one metrics row and one tearsheet named for the library, with meta propagated") {

        when {
            process {
                """
                input[0] = record(meta: [ id:'LIB_FULL', analysis_id:'test_analysis' ], artifacts_yaml: file("${moduleDir}/tests/fixtures/LIB_FULL.yaml"))
                """
            }
        }

        then {
            def metricsFile = file(process.out.summary[0].metrics)
            def tearsheetFile = file(process.out.summary[0].tearsheet)
            def rows = parseTsv(metricsFile.text)
            def header = metricsFile.readLines()[0].split('\t', -1) as List
            assertAll(
                { assert process.success },
                // one item per emit, same meta (id and analysis_id) on both
                { assert process.out.summary.size() == 1 },
                { assert process.out.summary.size() == 1 },
                { assert process.out.summary[0].meta == [ id:'LIB_FULL', analysis_id:'test_analysis' ] },
                { assert process.out.summary[0].meta == [ id:'LIB_FULL', analysis_id:'test_analysis' ] },
                // names come from meta.id
                { assert metricsFile.name == 'LIB_FULL.library_metrics.txt' },
                { assert tearsheetFile.name == 'LIB_FULL.standard_analysis_tearsheet.txt' },
                // header plus exactly one row; first column is the library id; fixed 48-column header
                { assert rows.size() == 1 },
                { assert header.size() == 48 },
                { assert header.take(6) == ['library', 'exp_date', 'reference', 'standard_analysis_dir', 'run_status', 'run_date'] },
                { assert header.takeRight(7) == ['AlignmentPDF', 'CBRB_tear_sheet_path', 'CBRB_html_path', 'SelectionPlot', 'DropulationReport', 'Metacell', 'gmg_dge_path'] },
                { assert rows[0].library == 'LIB_FULL' },
                // values from the fixture files
                { assert rows[0].exp_date == '2024-01-02' },
                { assert rows[0].reference == 'REF' },
                { assert rows[0].run_status == 'COMPLETED' },
                { assert rows[0].run_date == '2026-03-04' },
                { assert rows[0].total_reads_M.toDouble() == 2.0d },
                { assert rows[0].pct_mapped_reads.toDouble() == 95.0d },
                { assert rows[0].pct_hq_mapped_reads.toDouble() == 90.0d },
                { assert rows[0].pct_chimeric_UMIs.toDouble() == 0.5d },
                { assert rows[0].median_cell_UMIs_cbrb.toDouble() == 200.0d },
                { assert rows[0].scDblFinder_pct_doublets.toDouble() == 25.0d },
                // tearsheet rows
                { assert tearsheetFile.readLines() == ['label\tvalue', 'PF reads\t2000000', 'HQ mapped reads\t1800000', '% HQ mapped reads\t90.0%',
                    '% chimeric UMIs\t0.50%', 'median Reads/UMI(STAMPS)\t1.5', 'STAMPS\t3', 'median UMIs(STAMPS)\t200', 'ambient peak(UMIs)\t40'] }
            )
        }
    }

    test("Should succeed with NA metrics when every artifact of the library is NA") {

        when {
            process {
                """
                input[0] = record(meta: [ id:'LIB_NA', analysis_id:'test_analysis' ], artifacts_yaml: file("${moduleDir}/tests/fixtures/LIB_NA.yaml"))
                """
            }
        }

        then {
            def metricsFile = file(process.out.summary[0].metrics)
            def rows = parseTsv(metricsFile.text)
            def tearsheetFile = file(process.out.summary[0].tearsheet)
            // columns that are known without any artifact; every other column must be NA
            def known = ['library', 'reference', 'standard_analysis_dir']
            assertAll(
                { assert process.success },
                { assert rows.size() == 1 },
                { assert rows[0].library == 'LIB_NA' },
                { assert rows[0].reference == 'REF' },
                { assert rows[0].findAll { k, v -> !(k in known) }.every { k, v -> v == 'NA' } },
                // the tearsheet is still written, with only the chimeric row (NA)
                { assert tearsheetFile.readLines() == ['label\tvalue', '% chimeric UMIs\tNA'] }
            )
        }
    }
}
