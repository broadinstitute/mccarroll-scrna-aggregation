nextflow_process {

    name "Test Process RESOLVE_LIBRARIES"
    script "modules/local/resolve_libraries/main.nf"
    process "RESOLVE_LIBRARIES"
    config "./nextflow.config"
    tag "modules"
    tag "modules_local"
    tag "resolve_libraries"

    // Contract: tuple val(meta), val(artifact_texts) (LibraryResolver.readArtifactTexts of the artifacts directory), val(entries), val(reference or ''), val(mmc_model or '')
    //           -> summary: tuple val(meta), path('<meta.id>.resolved_libraries.tsv').
    // The summary is LibraryResolver.summaryText: a header and one tab-separated row per library in manifest order (library_id, dge,
    // cell_metadata, mmc_model, mmc_annotations, reduced_gtf, args_file, files; 'NA' for none). The resolver itself is unit tested in
    // subworkflows/local/utils_nfcore_scrna-aggregation_pipeline/tests/resolver.function.nf.test; these tests check the task around it.
    // A resolver error fails the task with the message in its stderr. The summary is not published: checked in tests/pipeline.live.nf.test.
    // Fixtures: tests/fixtures/README.md.

    def dgeA = '/fixtures/LIB_A/REF/cbrb/lr1/cell_selection/auto/standard_analysis/village/V1/LIB_A.donors.digital_expression.txt.gz'
    def dgeB = '/fixtures/LIB_B/REF/cbrb/lr1/cell_selection/auto/standard_analysis/LIB_B.selected.digital_expression.txt.gz'
    def rows = { f -> file(f).readLines().collect { it.split('\t', -1) as List } }

    test("Should write a header and one row for a library, with NA for the values it does not have") {

        when {
            process {
                """
                input[0] = [ [ id:'AN1' ], LibraryResolver.readArtifactTexts(java.nio.file.Paths.get("${moduleDir}/tests/fixtures/artifacts_one")) ]
                input[1] = AggregationManifest.parse("dges:\\n  - dge: ${dgeA}\\n")
                input[2] = ''
                input[3] = ''
                """
            }
        }

        then {
            def lines = rows(process.out.summary[0][1])
            assertAll(
                { assert process.success },
                { assert process.out.summary[0][0] == [ id:'AN1' ] },
                { assert file(process.out.summary[0][1]).name == 'AN1.resolved_libraries.tsv' },
                { assert lines[0] == ['library_id', 'dge', 'cell_metadata', 'mmc_model', 'mmc_annotations', 'reduced_gtf', 'args_file', 'files'] },
                { assert lines.size() == 2 },
                // donor DGE (the library has a village), its village cell metadata and its MapMyCells model and annotations
                { assert lines[1] == ['LIB_A', dgeA,
                    '/fixtures/LIB_A/REF/cbrb/lr1/cell_selection/auto/standard_analysis/village/V1/LIB_A.cmd.tsv',
                    'MODEL1',
                    '/fixtures/LIB_A/REF/cbrb/lr1/cell_selection/auto/standard_analysis/mmc/MODEL1/LIB_A.csv',
                    '/fixtures/reference/REF/REF.reduced.gtf',
                    'LIB_A.join_and_filter_args.txt',
                    'NA'] }
            )
        }
    }

    test("Should write one row per library in manifest order, with NA MapMyCells for a library without results") {

        when {
            process {
                """
                // manifest order is B then A, the reverse of the file names
                input[0] = [ [ id:'AN2' ], LibraryResolver.readArtifactTexts(java.nio.file.Paths.get("${moduleDir}/tests/fixtures/artifacts_two")) ]
                input[1] = AggregationManifest.parse("dges:\\n  - dge: ${dgeB}\\n  - dge: ${dgeA}\\n")
                input[2] = ''
                input[3] = ''
                """
            }
        }

        then {
            def lines = rows(process.out.summary[0][1])
            assertAll(
                { assert process.success },
                // no library lost or duplicated, in manifest order
                { assert lines.drop(1).collect { it[0] } == ['LIB_B', 'LIB_A'] },
                // LIB_B: selected-cells DGE, no MapMyCells; LIB_A: donor DGE with MapMyCells
                { assert lines[1][1] == dgeB },
                { assert lines[1][3..4] == ['NA', 'NA'] },
                { assert lines[2][1] == dgeA },
                { assert lines[2][3] == 'MODEL1' },
                // the arguments file of each library is named after it
                { assert lines.drop(1).collect { it[6] } == ['LIB_B.join_and_filter_args.txt', 'LIB_A.join_and_filter_args.txt'] },
                // all rows have the same columns
                { assert lines.every { it.size() == 8 } }
            )
        }
    }

    test("Should fail with the reason in its error output when the libraries cannot be resolved together") {

        when {
            process {
                """
                input[0] = [ [ id:'AN3' ], LibraryResolver.readArtifactTexts(java.nio.file.Paths.get("${moduleDir}/tests/fixtures/artifacts_conflict")) ]
                input[1] = AggregationManifest.parse("dges:\\n  - dge: ${dgeA}\\n  - dge: ${dgeB}\\n")
                input[2] = ''
                input[3] = ''
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains('Cannot resolve the libraries of AN3') },
                // LIB_A has the reference REF and LIB_B REF2
                { assert process.errorReport.contains('All DGEs must have the same reference') },
                { assert process.errorReport.contains('LIB_B') }
            )
        }
    }
}
