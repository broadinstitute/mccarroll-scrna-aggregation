// Config for the live Google Batch test of LOCATE_SCRNA_ARTIFACTS (tag 'batch').
// The task runs on a Google Batch VM and reads gs:// with the VM's service account (found through the metadata server).
// Deliberately NOT set here: google.batch.serviceAccountEmail (so Google Batch uses the project's default Compute Engine
// service account), any credentials mount (process.containerOptions) and GOOGLE_APPLICATION_CREDENTIALS.
// Run with --profile test (not the default docker,test): the docker profile would mount the local ADC into the task.
// Needs GOOGLE_PROJECT_ID and GOOGLE_LOCATION in the environment, and a gs:// -work-dir on the command line.
process.executor = 'google-batch'
google.project   = System.getenv('GOOGLE_PROJECT_ID')
google.location  = System.getenv('GOOGLE_LOCATION')
// bican-um1-mccarroll has no VPC named 'default' (Google Batch fails with CODE_GCE_RESOURCE_NOT_FOUND); its network is broad-allow.
google.batch.network    = 'global/networks/broad-allow'
google.batch.subnetwork = 'regions/us-central1/subnetworks/broad-allow'
// tests/nextflow.config (auto-loaded next to gcs_batch_check.nf) mounts the local fixtures; clear it, nothing is mounted on Google Batch.
process.containerOptions = ''
