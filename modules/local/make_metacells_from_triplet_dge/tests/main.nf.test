nextflow_process {

    name "Test Process MAKE_METACELLS_FROM_TRIPLET_DGE"
    script "modules/local/make_metacells_from_triplet_dge/main.nf"
    process "MAKE_METACELLS_FROM_TRIPLET_DGE"
    config "./nextflow.config"
    tag "modules"
    tag "modules_local"
    tag "make_metacells_from_triplet_dge"

    // Contract: record(meta: Map, matrix: Path, features: Path, barcodes: Path, cell_metadata: Path, group_columns: List<String>)
    //           -> metacells: record(meta: Map, metacells: Path '<ext.prefix ?: meta.id>.metacells.txt.gz').
    // Fixtures: tests/fixtures/README.md (cells, counts and the expected sums are worked out there). Uses the local private Java
    // image (nextflow.config). The live comparison with the baseline is in live.nf.test.

    def gzLines = { f -> new java.util.zip.GZIPInputStream(new FileInputStream(f.toString())).newReader().readLines() }
    // the metacell file as [ metacell name: [ GENEA count, GENEB count, ... ] ]; the '#MakeMetacellsFromTripletDge ...' line is skipped
    def metacells = { f ->
        def rows = gzLines(f).findAll { !it.startsWith('#') }.collect { it.split('\t', -1) as List }
        def names = rows[0].drop(1)
        [ genes: rows.drop(1).collect { it[0] },
          counts: names.indices.collectEntries { i -> [ (names[i]): rows.drop(1).collect { it[i + 1] as int } ] } ]
    }
    test("Should sum the counts of each donor's cells, joining the cells to the metadata by PREFIX and cell_barcode") {

        when {
            process {
                """
                input[0] = record(meta: [ id:'analysis1' ],
                    matrix: file("${moduleDir}/tests/fixtures/matrix.mtx.gz"), features: file("${moduleDir}/tests/fixtures/features.tsv.gz"),
                    barcodes: file("${moduleDir}/tests/fixtures/barcodes.tsv.gz"), cell_metadata: file("${moduleDir}/tests/fixtures/cell_metadata.tsv"),
                    group_columns: [ 'donor' ])
                """
            }
        }

        then {
            def result = metacells(process.out.metacells[0].metacells)
            assertAll(
                { assert process.success },
                { assert process.out.metacells.size() == 1 },
                // meta propagated; name from meta.id
                { assert process.out.metacells[0].meta == [ id:'analysis1' ] },
                { assert file(process.out.metacells[0].metacells).name == 'analysis1.metacells.txt.gz' },
                // gene_id per row, in features order
                { assert result.genes == ['ENSG01', 'ENSG02', 'ENSG03'] },
                // D1 = LIB_A_AAAA + LIB_A_CCCC; D2 = LIB_B_AAAA + LIB_B_TTTT (rows GENEA, GENEB, GENEC)
                { assert result.counts.keySet() == ['D1', 'D2'] as Set },
                { assert result.counts['D1'] == [3, 8, 0] },
                { assert result.counts['D2'] == [4, 18, 13] }
            )
        }
    }

    test("Should sum the counts per donor and cell type, naming the metacells donor:cell_type") {

        when {
            process {
                """
                input[0] = record(meta: [ id:'analysis1' ],
                    matrix: file("${moduleDir}/tests/fixtures/matrix.mtx.gz"), features: file("${moduleDir}/tests/fixtures/features.tsv.gz"),
                    barcodes: file("${moduleDir}/tests/fixtures/barcodes.tsv.gz"), cell_metadata: file("${moduleDir}/tests/fixtures/cell_metadata.tsv"),
                    group_columns: [ 'donor', 'cell_type' ])
                """
            }
        }

        then {
            def result = metacells(process.out.metacells[0].metacells)
            assertAll(
                { assert process.success },
                { assert result.counts.keySet() == ['D1:Glut', 'D1:GABA', 'D2:Glut', 'D2:GABA'] as Set },
                { assert result.counts['D1:Glut'] == [1, 3, 0] },
                { assert result.counts['D1:GABA'] == [2, 5, 0] },
                { assert result.counts['D2:Glut'] == [4, 7, 0] },
                { assert result.counts['D2:GABA'] == [0, 11, 13] }
            )
        }
    }

    test("Should leave out cells that are not in the cell metadata or have an empty donor") {

        when {
            process {
                """
                input[0] = record(meta: [ id:'analysis1' ],
                    matrix: file("${moduleDir}/tests/fixtures/matrix.mtx.gz"), features: file("${moduleDir}/tests/fixtures/features.tsv.gz"),
                    barcodes: file("${moduleDir}/tests/fixtures/barcodes.tsv.gz"), cell_metadata: file("${moduleDir}/tests/fixtures/cell_metadata.tsv"),
                    group_columns: [ 'donor' ])
                """
            }
        }

        then {
            def result = metacells(process.out.metacells[0].metacells)
            assertAll(
                { assert process.success },
                // LIB_A_GGGG (no metadata row) and LIB_B_GGGG (empty donor) have 100/300 and 200/400 counts of GENEA/GENEC:
                // they are in no metacell, so the totals are exactly the sums of the other cells, and there is no unnamed metacell
                { assert !result.counts.containsKey('') },
                { assert result.counts.values().collect { it.sum() }.sum() == 3 + 8 + 4 + 18 + 13 },
                { assert result.counts.values().collect { it[0] }.sum() == 7 },
                { assert result.counts.values().collect { it[2] }.sum() == 13 }
            )
        }
    }

    test("Should keep a barcode that is in two libraries separate, each assigned to its own donor") {

        when {
            process {
                """
                input[0] = record(meta: [ id:'analysis1' ],
                    matrix: file("${moduleDir}/tests/fixtures/matrix.mtx.gz"), features: file("${moduleDir}/tests/fixtures/features.tsv.gz"),
                    barcodes: file("${moduleDir}/tests/fixtures/barcodes.tsv.gz"), cell_metadata: file("${moduleDir}/tests/fixtures/cell_metadata.tsv"),
                    group_columns: [ 'donor', 'cell_type' ])
                """
            }
        }

        then {
            def result = metacells(process.out.metacells[0].metacells)
            assertAll(
                { assert process.success },
                // AAAA is LIB_A_AAAA (D1 Glut, GENEA 1) and LIB_B_AAAA (D2 Glut, GENEA 4): never merged or swapped
                { assert result.counts['D1:Glut'][0] == 1 },
                { assert result.counts['D2:Glut'][0] == 4 }
            )
        }
    }

    test("Should fail when a group column is not in the cell metadata") {

        when {
            process {
                """
                input[0] = record(meta: [ id:'analysis1' ],
                    matrix: file("${moduleDir}/tests/fixtures/matrix.mtx.gz"), features: file("${moduleDir}/tests/fixtures/features.tsv.gz"),
                    barcodes: file("${moduleDir}/tests/fixtures/barcodes.tsv.gz"), cell_metadata: file("${moduleDir}/tests/fixtures/cell_metadata.tsv"),
                    group_columns: [ 'donor', 'no_such_column' ])
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.out.metacells.isEmpty() },
                // the tool names the missing column, so this is not some other failure (such as an unreadable input)
                { assert (process.stdout + process.stderr).join('\n').contains('no_such_column') }
            )
        }
    }
}
