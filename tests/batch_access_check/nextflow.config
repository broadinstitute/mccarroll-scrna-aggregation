// Google Batch with the project's default Compute service account: no google.batch.serviceAccountEmail, no credentials mounted.
process.executor        = 'google-batch'
google.project          = System.getenv('GOOGLE_PROJECT_ID')
google.location         = System.getenv('GOOGLE_LOCATION')
// bican-um1-mccarroll has no VPC named 'default'; its network is broad-allow.
google.batch.network    = 'global/networks/broad-allow'
google.batch.subnetwork = 'regions/us-central1/subnetworks/broad-allow'
process.resourceLimits  = [ cpus: 2, memory: 4.GB ]
