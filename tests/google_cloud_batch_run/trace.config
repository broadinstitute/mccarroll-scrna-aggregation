// Extra config for tests/google_cloud_batch_run/run.sh: a LOCAL trace with the memory columns (the default trace goes to --outdir
// and has no peak_rss), so the script can read it without downloading anything.
trace {
    enabled   = true
    overwrite = true
    file      = 'testing_google_cloud_batch_run/trace.txt'
    sep       = '\t'
    fields    = 'task_id,name,process,native_id,status,exit,attempt,container,cpus,memory,peak_rss,peak_vmem,realtime,%cpu'
}
