nextflow_pipeline {

    name "Test pipeline input validation"
    script "../main.nf"
    tag "pipeline"
    tag "pipeline_validation"

    // The pipeline needs --manifest (the aggregation YAML), --analysis_id and --outdir. Bad inputs must stop the run in PIPELINE_INITIALISATION, before any
    // process starts (so no Docker image is used and nothing is listed on gs://). The profile 'test' (conf/test.config) supplies the live manifest and
    // the analysis id of the baseline; each test overrides what it checks.

    test("Should fail before any process when --manifest is missing") {

        when {
            params {
                outdir = "$outputDir"
                manifest = null
            }
        }

        then {
            def output = (workflow.stdout + workflow.stderr).join('\n')
            assertAll(
                { assert workflow.failed },
                { assert output.contains('manifest') },
                { assert workflow.trace.tasks().size() == 0 }
            )
        }
    }

    test("Should fail before any process when --analysis_id is missing or has characters that are not safe in file names") {

        when {
            params {
                outdir = "$outputDir"
                analysis_id = null
            }
        }

        then {
            def output = (workflow.stdout + workflow.stderr).join('\n')
            assertAll(
                { assert workflow.failed },
                { assert output.contains('analysis_id') },
                { assert workflow.trace.tasks().size() == 0 }
            )
        }
    }

    test("Should reject an analysis id with a slash") {

        when {
            params {
                outdir = "$outputDir"
                analysis_id = "bad/id"
            }
        }

        then {
            def output = (workflow.stdout + workflow.stderr).join('\n')
            assertAll(
                { assert workflow.failed },
                { assert output.contains('analysis_id') },
                { assert workflow.trace.tasks().size() == 0 }
            )
        }
    }

    test("Should fail before any process on a manifest with an unknown key, naming the file, the DGE entry and the key") {

        when {
            params {
                outdir = "$outputDir"
                manifest = "${projectDir}/tests/fixtures/manifest_unknown_key.yaml"
            }
        }

        then {
            def output = (workflow.stdout + workflow.stderr).join('\n')
            assertAll(
                { assert workflow.failed },
                { assert output.contains('manifest_unknown_key.yaml') },
                { assert output.contains("Unexpected key 'filter'") },
                { assert output.contains('dge entry 1') },
                { assert workflow.trace.tasks().size() == 0 }
            )
        }
    }

    // --help is handled in PIPELINE_INITIALISATION, so it ends the run before any process: a bare --help reaches the pipeline as the string
    // 'true' (PIPELINE_INITIALISATION prints the general help itself), --help <parameter name> is handled by the nf-core help code.
    // The help is logged at INFO level, which nf-test leaves out of workflow.stdout unless it runs with --verbose, so the tests read it from the
    // run's nextflow.log. They look for words of the parameter descriptions in nextflow_schema.json: the log also has the example command.

    test("Should print the general help and succeed, without starting a process, with a bare --help") {

        when {
            params {
                help = 'true'
            }
        }

        then {
            def output = (workflow.stdout + workflow.stderr).join('\n') + file("${metaDir}/nextflow.log").text
            assertAll(
                { assert workflow.success },
                { assert output.contains('Typical pipeline command') },
                // the description of the pipeline's parameters are listed: all of them, not one
                { assert output.contains('Label for this aggregation') },
                { assert output.contains('MapMyCells model to use instead of the first model') },
                { assert !output.contains('does not exist in JSON schema') },
                { assert workflow.trace.tasks().size() == 0 }
            )
        }
    }

    test("Should describe one parameter, and succeed, with --help and a parameter name") {

        when {
            params {
                help = 'analysis_id'
            }
        }

        then {
            def output = (workflow.stdout + workflow.stderr).join('\n') + file("${metaDir}/nextflow.log").text
            assertAll(
                { assert workflow.success },
                // the description and the pattern of that parameter only, not the other parameters
                { assert output.contains('Label for this aggregation') },
                { assert output.contains('pattern') },
                { assert !output.contains('MapMyCells model to use instead of the first model') },
                { assert workflow.trace.tasks().size() == 0 }
            )
        }
    }
}
