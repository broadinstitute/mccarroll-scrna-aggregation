/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

// TODO nf-core: Specify any additional parameters here
// Or any resources requirements
params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/scrna-aggregation'
}

// Pipeline tests run on this machine: a memory cap that
// fits Docker here (it lowers the 15 GB of MAKE_TRIPLET_DGE; the JVM gets 80% of it). The live manifest has one library of a few hundred cells.
process.resourceLimits = [ memory: 4.GB, cpus: 2 ]

aws.client.anonymous = true // fixes S3 access issues on self-hosted runners
