/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    mccarroll/scrna-aggregation Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs (types are declared in the params block of main.nf)
includeConfig 'conf/params.config'

// Where the `output` block of main.nf publishes (the published files are listed there, not in conf/modules.config)
outputDir = params.outdir
workflow.output.mode = params.publish_dir_mode

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        // The Drop-seq images are linux/amd64 only; the platform flag is a no-op on an amd64 host
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
        // Local runs authenticate to GCS with a credentials JSON (your gcloud Application Default Credentials, or a
        // service account key), mounted read-only into every task container. PIPELINE_INITIALISATION checks the file exists.
        env.GOOGLE_APPLICATION_CREDENTIALS = '/opt/gcp/adc.json'
        // The Google storage client also needs a project ID; same variable as the googlebatch profile
        env.GOOGLE_CLOUD_PROJECT = System.getenv('GOOGLE_PROJECT_ID') ?: ''
        process.containerOptions = "-v ${params.gcp_credentials_file ?: System.getProperty('user.home') + '/.config/gcloud/application_default_credentials.json'}:/opt/gcp/adc.json:ro"
    }
    googlebatch {
        // For runs launched with `nextflow run` (not Seqera Platform: its compute environment supplies the project, region,
        // work directory and network, so this profile is not needed there). Requires GOOGLE_PROJECT_ID and GOOGLE_LOCATION in
        // the environment (the project that owns the buckets, and the region, normally us-central1) and a gs:// -work-dir.
        // Tasks authenticate through the VM's service account (by default the project's Compute Engine one); no credentials are mounted.
        // The network is broad-allow: new McCarroll projects have no 'default' VPC (mccarroll-scrna-seq has both).
        process.executor        = 'google-batch'
        // Exact machine types. A wildcard such as 'n1-*' (or no machineType) makes Nextflow use the deprecated Cloud Info service and
        // warn once; only an exact type avoids it, and Nextflow does not check that the request fits the type. So each type below
        // must hold the cpus and memory of its attempt (default process: 1 cpu and 6 GB, then 2 cpus and 12 GB; the three Java steps
        // in conf/modules.config: 6 cpus and 15 GB, then 6 cpus and 30 GB). Change them together.
        process.machineType     = { task.attempt == 1 ? 'n1-standard-2' : 'n1-standard-4' }
        process {
            withName: 'MAKE_TRIPLET_DGE|DONOR_METACELLS|DONOR_CELL_TYPE_METACELLS' {
                machineType = { task.attempt == 1 ? 'n1-standard-8' : 'n1-highmem-8' }
            }
        }
        // (strict config syntax has no `if`: an unset variable gives null, so set both variables for this profile)
        google.project          = System.getenv('GOOGLE_PROJECT_ID')
        google.location         = System.getenv('GOOGLE_LOCATION')
        google.batch.network    = "projects/${System.getenv('GOOGLE_PROJECT_ID')}/global/networks/broad-allow"
        google.batch.subnetwork = "projects/${System.getenv('GOOGLE_PROJECT_ID')}/regions/${System.getenv('GOOGLE_LOCATION')}/subnetworks/broad-allow"
        // The Seqera compute environments also tag the VMs 'broad-allow' (firewall targeting); same here
        google.batch.networkTags = ['broad-allow']
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    test      { includeConfig 'conf/test.config'      }
}

// The nf-core institutional configs (nfcore_custom.config) are NOT loaded: they define profiles that clash with ours (googlebatch).

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'



// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'mccarroll/scrna-aggregation'
    contributors    = [
        [
            name: 'James Nemesh',
            affiliation: 'Broad Institute',
            email: 'nemesh@broadinstitute.org',
            github: 'jamesnemesh',
            contribution: ['author', 'maintainer'], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
        [
            name: 'Alec Wysoker',
            affiliation: 'Broad Institute',
            email: '',
            github: '',
            contribution: ['author'], // Original pipeline
            orcid: ''
        ],
        [
            name: 'Khalid Shakir',
            affiliation: 'Broad Institute',
            email: '',
            github: '',
            contribution: ['author'], // Original pipeline
            orcid: ''
        ],
    ]
    homePage        = 'https://github.com/broadinstitute/mccarroll-scrna-aggregation'
    description     = """A Nextflow workflow for merging mccarroll scrna results across multiple experiments"""
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=25.04.0'
    version         = '1.0.0dev'
    doi             = ''
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.7.1' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

validation {
    defaultIgnoreParams = ["genomes"]
    monochromeLogs = params.monochrome_logs
}

// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'
