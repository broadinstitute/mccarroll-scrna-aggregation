/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    mccarroll/scrna-aggregation default parameter values
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    The single place for parameter defaults; included by nextflow.config.
    The types of the parameters are declared in the params block of main.nf.
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {

    // Input options
    manifest                   = null   // YAML aggregation manifest: dgeDefaults + dges[dge, donor, filters, joins] (local path or gs://)
    analysis_id                = null   // label of this aggregation: prefix of the merged output files
    mmc_model                  = null   // MapMyCells model to use instead of the first model of each library (all libraries with results must share one)
    mmc_level                  = null   // MapMyCells taxonomy level for the cell type column (default: the top level of the taxonomy)

    // Boilerplate options
    outdir                       = null
    publish_dir_mode             = 'copy'
    monochrome_logs              = false
    help                       = null
    help_full                    = false
    show_hidden                  = false
    version                      = false
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')

    // GCP credentials JSON for local (docker profile) runs; mounted into task containers.
    // Null unless given: the docker profile and PIPELINE_INITIALISATION then use your gcloud Application Default Credentials
    // ($HOME/.config/gcloud/application_default_credentials.json); on a cluster/VM point it at a service account key.
    // Not used (and so not shown in the parameter summary) on Google Batch.
    gcp_credentials_file       = null

    // Config options
    config_profile_name        = null
    config_profile_description = null

    config_profile_contact     = null
    config_profile_url         = null

    // Schema validation default options
    validate_params            = true
}
