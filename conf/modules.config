/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    // Nothing is published unless it is listed below. The merged results go flat in the output directory; the per-library records that are
    // published (the artifact files and the tearsheets) go in directories of their own. All other per-library files stay in the work directory.
    publishDir = [ enabled: false ]

    // The merged results, flat in the output directory (the cell type column file is written by the workflow, to the same place).
    // Publishing is off when there is no --outdir, as in the module tests, which run a single process.
    withName: 'MERGE_LIBRARY_METRICS|MERGE_CELL_METADATA|MAKE_TRIPLET_DGE|DONOR_CELL_TYPE_REPORT|DONOR_METACELLS|DONOR_CELL_TYPE_METACELLS' {
        publishDir = [ path: { params.outdir }, mode: params.publish_dir_mode, enabled: params.outdir != null ]
    }

    // Files the workflow writes itself (WRITE_TEXT_FILE, one alias per file): the resolved libraries summary and the versions file in pipeline_info/,
    // the cell type column file flat in the output directory. The per-library arguments files (WRITE_ARGS_FILE) stay in the work directory.
    withName: 'WRITE_RESOLVED_SUMMARY|WRITE_VERSIONS' {
        publishDir = [ path: { "${params.outdir}/pipeline_info" }, mode: params.publish_dir_mode, enabled: params.outdir != null ]
    }
    withName: 'WRITE_CELL_TYPE_COLUMN' {
        publishDir = [ path: { params.outdir }, mode: params.publish_dir_mode, enabled: params.outdir != null ]
    }

    // Per-library records: artifacts/<library>.yaml (the directory LOCATE writes) and tearsheets/<library>.standard_analysis_tearsheet.txt
    // (the library metrics file next to them is an intermediate of the merged metrics)
    withName: 'LOCATE_SCRNA_ARTIFACTS' {
        publishDir = [ path: { params.outdir }, mode: params.publish_dir_mode, enabled: params.outdir != null ]
    }
    withName: 'SUMMARIZE_SCRNA_EXPERIMENTS' {
        publishDir = [ path: { params.outdir }, mode: params.publish_dir_mode, enabled: params.outdir != null, saveAs: { filename -> filename.startsWith('tearsheets/') ? filename : null } ]
    }

    // The formatted MapMyCells TSV is an intermediate: it stays in the task's work directory. Its columns are prefixed with the model name.
    withName: 'FORMAT_MAPMYCELLS_ANNOTATIONS' {
        ext.args = { "--column-prefix ${meta.mmc_model}_" + (params.mmc_level ? " --level ${params.mmc_level}" : '') }
    }

    // Merged per-library cell metadata: <analysis>.cell_metadata.txt, indexed by (PREFIX, cell_barcode) so that a duplicate cell fails
    withName: 'MERGE_CELL_METADATA' {
        ext.args   = '--index-col PREFIX --index-col cell_barcode'
        ext.prefix = { "${meta.id}.cell_metadata" }
    }

    // The sparse DGE and the metacells. 16 GB to start (the JVM heap is 80% of it, see the modules); to be tuned on Google Batch.
    withName: 'MAKE_TRIPLET_DGE|DONOR_METACELLS|DONOR_CELL_TYPE_METACELLS' {
        memory = { 16.GB * task.attempt }
    }

    // Metacells: <analysis>.donors.metacells.txt.gz and <analysis>.donor_cell_type.metacells.txt.gz
    withName: 'DONOR_METACELLS' {
        ext.prefix = { "${meta.id}.donors" }
    }
    withName: 'DONOR_CELL_TYPE_METACELLS' {
        ext.prefix = { "${meta.id}.donor_cell_type" }
    }

    // Merged per-library metrics: <analysis>.library_metrics.txt, no index columns (as in the prototype)
    withName: 'MERGE_LIBRARY_METRICS' {
        ext.prefix = { "${meta.id}.library_metrics" }
    }

}
